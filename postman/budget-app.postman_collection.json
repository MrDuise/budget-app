{
  "info": {
    "name": "Budget App API",
    "_postman_id": "budget-app-v1",
    "description": "Complete API collection for the household budget app.\n\n## Setup\n1. Run `npm run dev` (app at http://localhost:3000)\n2. Run `npm run db:seed` if no data exists yet\n3. Import this collection into Postman\n4. Run the **🔐 Auth** folder first — it stores your session cookie automatically\n5. Run remaining folders in order (each builds on IDs captured by earlier requests)\n\n## Seed credentials\n- Email: test@example.com\n- Password: password123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "test@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "csrfToken", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "customCategoryId", "value": "" },
    { "key": "txId", "value": "" },
    { "key": "recurringTxId", "value": "" },
    { "key": "planTxId", "value": "" },
    { "key": "budgetLimitId", "value": "" },
    { "key": "inviteToken", "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1. Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/csrf", "host": ["{{baseUrl}}"], "path": ["api", "auth", "csrf"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', data.csrfToken);",
                  "pm.test('Got CSRF token', () => pm.expect(data.csrfToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}" },
                { "key": "email", "value": "{{email}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "redirect", "value": "false" },
                { "key": "json", "value": "true" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/auth/callback/credentials", "host": ["{{baseUrl}}"], "path": ["api", "auth", "callback", "credentials"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded (session cookie set)', () => {",
                  "  const cookies = pm.cookies.toObject();",
                  "  const hasSession = Object.keys(cookies).some(k => k.includes('session-token') || k.includes('authjs'));",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📁 Accounts",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Checking\",\n  \"type\": \"checking\",\n  \"currentBalance\": 2500,\n  \"includeInTotal\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accountId', data.id);",
                  "pm.test('Has id', () => pm.expect(data.id).to.be.a('string'));",
                  "pm.test('Balance set', () => pm.expect(data.currentBalance).to.eql(2500));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Accounts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('accountId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Account Balance",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentBalance\": 3200,\n  \"notes\": \"Updated after paycheck\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Balance updated', () => pm.expect(pm.response.json().currentBalance).to.eql(3200));"
                ]
              }
            }
          ]
        }
      ]
    },
